{
  "framework": null,
  "installCommand": "echo 'skip install (static Relay site)'",
  "buildCommand": "mkdir -p .vercel-out && cp -R public/. .vercel-out/ && cp -f robots.txt sitemap.xml thankyou.html .vercel-out/ && cp -f index.md .vercel-out/ || true",
  "outputDirectory": ".vercel-out",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.clevertree.net" }],
      "destination": "https://clevertree.net/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/thankyou",
      "destination": "/thankyou.html"
    }
  ]
}
